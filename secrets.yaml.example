# Copy this file to secrets.yaml and fill in your values.
#   cp secrets.yaml.example secrets.yaml
# secrets.yaml is gitignored — never commit real credentials.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# 32-byte base64 key for the ESPHome native API encryption.
# Generate one with:   openssl rand -base64 32
# (or use the "key" generator at https://esphome.io/components/api.html)
esp_433_radio__encryption_key: "BASE64_32_BYTE_KEY"
